  async function doLogout() {
    await fetch('/api/auth/logout', { method: 'POST', cache: 'no-store' });
    window.location.reload();
  }

  async function loadProgress() {
    let listResp;
    try {
      listResp = await fetch('/api/records/list', { cache: 'no-store' });
    } catch (e) {
      document.getElementById('mp-wrap').innerHTML = '<div class="mp-empty-card"><p>Something went wrong loading your progress. Please refresh.</p></div>';
      return;
    }

    if (listResp.status === 401) {
      renderLoginForm();
      return;
    }
    if (!listResp.ok) {
      document.getElementById('mp-wrap').innerHTML = '<div class="mp-empty-card"><p>Something went wrong loading your progress. Please refresh.</p></div>';
      return;
    }

    const data = await listResp.json();

    // Fetch the generic tool_results too (calorie calculator, and any
    // future calculator wired up via TOOL_META). Non-fatal if it fails —
    // the BMI section above still renders fine on its own.
    let toolRecordsByTool = {};
    try {
      const toolResp = await fetch('/api/tools/list', { cache: 'no-store' });
      if (toolResp.ok) {
        const toolData = await toolResp.json();
        (toolData.records || []).forEach(r => {
          (toolRecordsByTool[r.tool] = toolRecordsByTool[r.tool] || []).push(r);
        });
      }
    } catch (e) { /* non-fatal */ }

    renderApp(data.records || [], toolRecordsByTool);
  }

  loadProgress();
</script>

</Base>

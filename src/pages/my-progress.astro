---
import Base from '../layouts/Base.astro';
---
<Base
  title="My Progress — HealthyBMICheck.com"
  description="Track your BMI and weight history over time."
  canonical="https://healthybmicheck.com/my-progress"
  noIndex={true}
>

<style>
  .mp-wrap { max-width: 760px; margin: 0 auto; padding: 48px 20px 70px; }

  .mp-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; gap: 16px; }
  .mp-header h1 { font-family: 'DM Serif Display', serif; font-size: 2rem; font-weight: 400; color: var(--ink); line-height: 1.1; margin-bottom: 6px; }
  .mp-header p { font-size: .9rem; color: var(--ink3); }
  .mp-logout { background: none; border: 1px solid var(--border); border-radius: 100px; padding: 8px 16px; font-size: .8rem; color: var(--ink3); cursor: pointer; font-family: inherit; white-space: nowrap; transition: border-color .15s, color .15s; }
  .mp-logout:hover { border-color: var(--accent); color: var(--accent); }

  .mp-loading { text-align: center; padding: 80px 20px; color: var(--ink3); font-size: .9rem; }

  /* Stats strip */
  .mp-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px; }
  .mp-stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 18px; }
  .mp-stat-label { font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .07em; color: var(--ink3); margin-bottom: 6px; }
  .mp-stat-value { font-family: 'DM Serif Display', serif; font-size: 1.6rem; color: var(--ink); display: flex; align-items: baseline; gap: 6px; }
  .mp-stat-value .unit { font-family: 'DM Sans', sans-serif; font-size: .8rem; color: var(--ink3); font-weight: 500; }
  .mp-stat-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; flex-shrink: 0; }
  .mp-stat-sub { font-size: .78rem; margin-top: 4px; font-weight: 600; }
  .mp-stat-sub.up { color: var(--danger); }
  .mp-stat-sub.down { color: var(--accent); }
  .mp-stat-sub.flat { color: var(--ink3); }

  /* Chart card */
  .mp-chart-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px 20px 16px; margin-bottom: 20px; }
  .mp-chart-title { font-size: .85rem; font-weight: 600; color: var(--ink); margin-bottom: 4px; }
  .mp-chart-sub { font-size: .78rem; color: var(--ink3); margin-bottom: 16px; }
  .mp-legend { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); }
  .mp-legend-item { display: flex; align-items: center; gap: 6px; font-size: .74rem; color: var(--ink3); }
  .mp-legend-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }

  /* History table */
  .mp-table-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .mp-table-title { font-size: .85rem; font-weight: 600; color: var(--ink); padding: 18px 20px 12px; }
  .mp-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  .mp-table th { text-align: left; padding: 10px 20px; color: var(--ink3); font-weight: 600; font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; border-bottom: 1px solid var(--border); }
  .mp-table td { padding: 12px 20px; border-bottom: 1px solid var(--border); color: var(--ink); }
  .mp-table tr:last-child td { border-bottom: none; }
  .mp-table tr:hover td { background: var(--accent-light); }
  .mp-cat-badge { display: inline-block; padding: 3px 11px; border-radius: 100px; font-size: .72rem; font-weight: 600; color: #fff; }
  .mp-delta { font-size: .78rem; margin-left: 6px; font-weight: 600; }
  .mp-delta.up { color: var(--danger); }
  .mp-delta.down { color: var(--accent); }

  .mp-table-header { display: flex; justify-content: space-between; align-items: center; padding: 18px 20px 12px; }
  .mp-delete-all { background: none; border: none; font-size: .78rem; color: var(--ink3); cursor: pointer; font-family: inherit; padding: 4px 0; }
  .mp-delete-all:hover { color: var(--danger); text-decoration: underline; }
  .mp-row-delete { background: none; border: none; cursor: pointer; color: var(--ink3); font-size: .95rem; padding: 4px 6px; border-radius: 6px; line-height: 1; }
  .mp-row-delete:hover { color: var(--danger); background: var(--danger-light); }
  .mp-table td.mp-actions { text-align: right; width: 1%; white-space: nowrap; }

  /* Empty state */
  .mp-empty-card { background: var(--surface); border: 1px dashed var(--border); border-radius: var(--radius); padding: 48px 32px; text-align: center; }
  .mp-empty-icon { font-size: 2.2rem; margin-bottom: 12px; }
  .mp-empty-card h2 { font-family: 'DM Serif Display', serif; font-size: 1.3rem; font-weight: 400; color: var(--ink); margin-bottom: 8px; }
  .mp-empty-card p { font-size: .88rem; color: var(--ink3); margin-bottom: 20px; max-width: 360px; margin-left: auto; margin-right: auto; line-height: 1.6; }

  /* Login card */
  .mp-login-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 32px 28px; max-width: 420px; margin: 40px auto; text-align: center; }
  .mp-login-icon { font-size: 1.8rem; margin-bottom: 10px; }
  .mp-login-card h1 { font-family: 'DM Serif Display', serif; font-size: 1.4rem; font-weight: 400; color: var(--ink); margin-bottom: 8px; }
  .mp-login-card p { font-size: .88rem; color: var(--ink3); line-height: 1.6; margin-bottom: 18px; text-align: left; }
  .mp-input { width: 100%; padding: 11px 14px; border: 1px solid var(--border); border-radius: 10px; font-size: .9rem; font-family: inherit; margin-bottom: 12px; box-sizing: border-box; background: var(--bg); color: var(--ink); }
  .mp-checkbox { display: flex; align-items: flex-start; gap: 8px; font-size: .8rem; color: var(--ink); margin-bottom: 10px; line-height: 1.4; cursor: pointer; text-align: left; }
  .mp-checkbox input { margin-top: 3px; flex-shrink: 0; }
  .mp-status { margin-top: 10px; font-size: .82rem; text-align: center; min-height: 1.2em; }
  .mp-status.success { color: var(--accent); }
  .mp-status.error { color: var(--danger); }

  @media (max-width: 560px) {
    .mp-stats { grid-template-columns: 1fr; }
    .mp-header { flex-direction: column; }
  }
</style>

<div class="mp-wrap" id="mp-wrap">
  <div class="mp-loading" id="mp-loading">Loading your progress…</div>
</div>

<script is:inline>
  // BMI category thresholds + colors, matching the scale used on the
  // calculator pages themselves — this page reuses the same visual
  // language rather than inventing a generic dashboard palette.
  const BMI_BANDS = [
    { max: 18.5, key: 'underweight', label: 'Underweight', color: 'var(--underweight)', badgeColor: 'var(--badge-underweight)' },
    { max: 25,   key: 'normal',      label: 'Normal',       color: 'var(--accent)',      badgeColor: 'var(--badge-normal)' },
    { max: 30,   key: 'overweight',  label: 'Overweight',   color: 'var(--warn)',        badgeColor: 'var(--badge-overweight)' },
    { max: Infinity, key: 'obese',   label: 'Obese',        color: 'var(--danger)',      badgeColor: 'var(--badge-obese)' },
  ];

  // Metadata for the generic tool_results-backed sections. Add an entry
  // here (and give the calculator's own "Save & Track" panel a matching
  // `tool` value) to extend progress-tracking to another calculator —
  // no new backend endpoints or DB migration needed per tool.
  const TOOL_META = {
    'calorie-calculator': { title: 'Calorie Calculator', icon: '🔥', href: '/calorie-calculator' },
    'bmr-calculator': { title: 'BMR Calculator', icon: '⚡', href: '/bmr-calculator' },
    'body-fat': { title: 'Body Fat Calculator', icon: '📊', href: '/body-fat' },
    'calorie-deficit-calculator': { title: 'Calorie Deficit Calculator', icon: '📉', href: '/calorie-deficit-calculator' },
    'calories-burned-calculator': { title: 'Calories Burned Calculator', icon: '🏃', href: '/calories-burned-calculator' },
    'ideal-weight': { title: 'Ideal Weight Calculator', icon: '🎯', href: '/ideal-weight' },
    'lean-body-mass': { title: 'Lean Body Mass Calculator', icon: '💪', href: '/lean-body-mass' },
    'macro-calculator': { title: 'Macro Calculator', icon: '🍽️', href: '/macro-calculator' },
    'pregnancy-weight-gain-calculator': { title: 'Pregnancy Weight Gain Calculator', icon: '🤰', href: '/pregnancy-weight-gain-calculator' },
    'protein-calculator': { title: 'Protein Calculator', icon: '🍗', href: '/protein-calculator' },
    'waist-to-height-ratio': { title: 'Waist-to-Height Ratio', icon: '📏', href: '/waist-to-height-ratio' },
    'waist-to-hip-ratio': { title: 'Waist-to-Hip Ratio', icon: '📐', href: '/waist-to-hip-ratio' },
    'water-intake': { title: 'Water Intake Calculator', icon: '💧', href: '/water-intake' },
    'health-profile': { title: 'Health Profile', icon: '👤', href: '/health-profile' },
    'bmi-calculator-kids': { title: "Child's Growth (BMI-for-Age)", icon: '🧒', href: '/bmi-calculator-kids' },
  };

  function bandFor(bmi) {
    return BMI_BANDS.find(b => bmi < b.max) || BMI_BANDS[BMI_BANDS.length - 1];
  }

  function fmtDate(iso, short) {
    const d = new Date(iso.replace(' ', 'T') + 'Z');
    return d.toLocaleDateString('en-GB', short
      ? { day: 'numeric', month: 'short' }
      : { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function renderChart(records) {
    const w = 640, h = 260;
    const padL = 34, padR = 14, padT = 16, padB = 34;
    const chartW = w - padL - padR, chartH = h - padT - padB;

    const bmis = records.map(r => r.bmi);
    const yMin = Math.min(15, Math.min(...bmis) - 2);
    const yMax = Math.max(33, Math.max(...bmis) + 2);

    const yOf = (bmi) => padT + (1 - (bmi - yMin) / (yMax - yMin)) * chartH;
    const xOf = (i) => records.length === 1
      ? padL + chartW / 2
      : padL + (i / (records.length - 1)) * chartW;

    // Background category bands, clipped to the chart's y-range
    const bandEdges = [yMin, 18.5, 25, 30, yMax];
    const bands = BMI_BANDS.map((b, i) => {
      const top = Math.max(bandEdges[i], yMin);
      const bottom = Math.min(bandEdges[i + 1], yMax);
      if (bottom <= top) return '';
      const y1 = yOf(bottom), y2 = yOf(top);
      return `<rect x="${padL}" y="${y1}" width="${chartW}" height="${y2 - y1}" fill="${b.color}" opacity="0.08" />`;
    }).join('');

    // Y-axis gridlines at the two clinical cutoffs plus min/max
    const gridVals = [18.5, 25, 30].filter(v => v > yMin && v < yMax);
    const gridlines = gridVals.map(v => {
      const y = yOf(v);
      return `<line x1="${padL}" y1="${y}" x2="${w - padR}" y2="${y}" stroke="var(--border)" stroke-width="1" stroke-dasharray="3,3" />
              <text x="${padL - 6}" y="${y + 3}" text-anchor="end" font-size="9" fill="var(--ink3)">${v}</text>`;
    }).join('');

    const pts = records.map((r, i) => [xOf(i), yOf(r.bmi)]);
    const linePath = pts.map((p, i) => (i === 0 ? 'M' : 'L') + p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');

    const circles = records.map((r, i) => {
      const [x, y] = pts[i];
      const isLast = i === records.length - 1;
      const color = bandFor(r.bmi).color;
      const r_ = isLast ? 6 : 4;
      return `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${r_}" fill="${color}" stroke="var(--surface)" stroke-width="2">
                <title>${fmtDate(r.recorded_at)} — BMI ${r.bmi} (${r.bmi_category})</title>
              </circle>`;
    }).join('');

    // Date labels: first, last, and middle (if room)
    const labelIdxs = records.length <= 2 ? [0, records.length - 1] : [0, Math.round((records.length - 1) / 2), records.length - 1];
    const dateLabels = [...new Set(labelIdxs)].map(i => {
      const x = xOf(i);
      return `<text x="${x}" y="${h - padB + 18}" text-anchor="middle" font-size="9" fill="var(--ink3)">${fmtDate(records[i].recorded_at, true)}</text>`;
    }).join('');

    const lastPt = pts[pts.length - 1];
    const lastLabel = `<text x="${lastPt[0]}" y="${lastPt[1] - 12}" text-anchor="middle" font-size="11" font-weight="600" fill="var(--ink)">${records[records.length - 1].bmi}</text>`;

    return `
      <svg viewBox="0 0 ${w} ${h}" style="width:100%;height:auto;display:block;" role="img" aria-label="BMI trend chart">
        ${bands}
        ${gridlines}
        ${records.length > 1 ? `<path d="${linePath}" fill="none" stroke="var(--ink2)" stroke-width="2" />` : ''}
        ${circles}
        ${records.length > 1 ? dateLabels : ''}
        ${lastLabel}
      </svg>`;
  }

  function renderStats(records) {
    const latest = records[records.length - 1];
    const first = records[0];
    const band = bandFor(latest.bmi);
    const delta = Math.round((latest.bmi - first.bmi) * 10) / 10;
    const deltaClass = delta > 0 ? 'up' : delta < 0 ? 'down' : 'flat';
    const deltaArrow = delta > 0 ? '▲' : delta < 0 ? '▼' : '—';
    const deltaText = records.length > 1
      ? `${deltaArrow} ${Math.abs(delta)} since ${fmtDate(first.recorded_at, true)}`
      : 'Log another result to see your trend';

    return `
      <div class="mp-stats">
        <div class="mp-stat-card">
          <div class="mp-stat-label">Latest BMI</div>
          <div class="mp-stat-value"><span class="mp-stat-dot" style="background:${band.color}"></span>${latest.bmi}</div>
          <div class="mp-stat-sub" style="color:${band.color}">${latest.bmi_category}</div>
        </div>
        <div class="mp-stat-card">
          <div class="mp-stat-label">Change</div>
          <div class="mp-stat-value">${records.length > 1 ? Math.abs(delta) : '—'}<span class="unit">BMI pts</span></div>
          <div class="mp-stat-sub ${deltaClass}">${deltaText}</div>
        </div>
        <div class="mp-stat-card">
          <div class="mp-stat-label">Entries logged</div>
          <div class="mp-stat-value">${records.length}</div>
          <div class="mp-stat-sub flat">Since ${fmtDate(first.recorded_at, true)}</div>
        </div>
      </div>`;
  }

  // --- Generic tool-history rendering (calorie calculator, and any
  // future calculator wired up via TOOL_META + /api/tools/*) ---

  function renderToolChart(records) {
    const w = 640, h = 180;
    const padL = 40, padR = 14, padT = 14, padB = 30;
    const chartW = w - padL - padR, chartH = h - padT - padB;

    const vals = records.map(r => r.summary_value).filter(v => typeof v === 'number');
    if (vals.length === 0) return '';
    const yMin = Math.min(...vals) * 0.9;
    const yMax = Math.max(...vals) * 1.1;
    const yOf = (v) => padT + (1 - (v - yMin) / ((yMax - yMin) || 1)) * chartH;
    const xOf = (i) => records.length === 1 ? padL + chartW / 2 : padL + (i / (records.length - 1)) * chartW;

    const pts = records.map((r, i) => [xOf(i), yOf(r.summary_value)]);
    const linePath = pts.map((p, i) => (i === 0 ? 'M' : 'L') + p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
    const circles = records.map((r, i) => {
      const [x, y] = pts[i];
      const isLast = i === records.length - 1;
      return `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${isLast ? 6 : 4}" fill="var(--accent)" stroke="var(--surface)" stroke-width="2">
                <title>${fmtDate(r.recorded_at)} — ${r.summary_label}</title>
              </circle>`;
    }).join('');

    const labelIdxs = records.length <= 2 ? [0, records.length - 1] : [0, Math.round((records.length - 1) / 2), records.length - 1];
    const dateLabels = [...new Set(labelIdxs)].map(i => {
      return `<text x="${xOf(i)}" y="${h - padB + 16}" text-anchor="middle" font-size="9" fill="var(--ink3)">${fmtDate(records[i].recorded_at, true)}</text>`;
    }).join('');

    return `
      <svg viewBox="0 0 ${w} ${h}" style="width:100%;height:auto;display:block;" role="img" aria-label="Trend chart">
        ${records.length > 1 ? `<path d="${linePath}" fill="none" stroke="var(--ink2)" stroke-width="2" />` : ''}
        ${circles}
        ${records.length > 1 ? dateLabels : ''}
      </svg>`;
  }

  function renderToolSection(tool, records) {
    const meta = TOOL_META[tool] || { title: tool, icon: '📊', href: '/' };
    if (!records || records.length === 0) return '';

    const latest = records[records.length - 1];
    const rows = records.slice().reverse().map(r => `
      <tr>
        <td>${fmtDate(r.recorded_at)}</td>
        <td>${r.summary_label}</td>
        <td class="mp-actions"><button class="mp-row-delete" onclick="deleteToolRecord(${r.id})" aria-label="Delete this entry" title="Delete this entry">✕</button></td>
      </tr>`).join('');

    return `
      <div class="mp-chart-card">
        <div class="mp-chart-title">${meta.icon} ${meta.title}</div>
        <div class="mp-chart-sub">Latest: ${latest.summary_label}${records.length > 1 ? ' · Hover a point for details.' : ''}</div>
        ${renderToolChart(records)}
      </div>
      <div class="mp-table-card" style="margin-bottom:20px;">
        <div class="mp-table-header">
          <div class="mp-table-title" style="padding:0;">${meta.title} history</div>
          <button class="mp-delete-all" onclick="deleteAllToolHistory('${tool}')">Delete all history</button>
        </div>
        <table class="mp-table">
          <thead><tr><th>Date</th><th>Result</th><th></th></tr></thead>
          <tbody>${rows}</tbody>
        </table>
      </div>`;
  }

  function renderApp(records, toolRecordsByTool) {
    const wrap = document.getElementById('mp-wrap');
    toolRecordsByTool = toolRecordsByTool || {};
    const toolSectionsHtml = Object.keys(TOOL_META)
      .map(tool => renderToolSection(tool, toolRecordsByTool[tool]))
      .join('');

    const header = `
      <div class="mp-header">
        <div>
          <h1>My Progress</h1>
          <p>Your health calculator history, tracked over time.</p>
        </div>
        <button class="mp-logout" onclick="doLogout()">Log out</button>
      </div>`;

    if (records.length === 0) {
      wrap.innerHTML = header + `
        <div class="mp-empty-card" style="margin-bottom:20px;">
          <div class="mp-empty-icon">📈</div>
          <h2>No BMI history yet</h2>
          <p>Save a result from the BMI Calculator to start building your trend line.</p>
          <a href="/bmi-calculator" class="calc-btn" style="display:inline-block;text-decoration:none;">Go to BMI Calculator →</a>
        </div>
        ${toolSectionsHtml}`;
      return;
    }

    const rows = records.slice().reverse().map((r, idx, arr) => {
      const prev = arr[idx + 1];
      const band = bandFor(r.bmi);
      let delta = '';
      if (prev) {
        const d = Math.round((r.weight_kg - prev.weight_kg) * 10) / 10;
        if (d !== 0) {
          const cls = d > 0 ? 'up' : 'down';
          const arrow = d > 0 ? '▲' : '▼';
          delta = `<span class="mp-delta ${cls}">${arrow} ${Math.abs(d)}kg</span>`;
        }
      }
      return `
      <tr>
        <td>${fmtDate(r.recorded_at)}</td>
        <td>${r.bmi}</td>
        <td><span class="mp-cat-badge" style="background:${band.badgeColor}">${r.bmi_category}</span></td>
        <td>${r.weight_kg} kg${delta}</td>
        <td class="mp-actions"><button class="mp-row-delete" onclick="deleteRecord(${r.id})" aria-label="Delete this entry" title="Delete this entry">✕</button></td>
      </tr>`;
    }).join('');

    wrap.innerHTML = header + `
      ${renderStats(records)}

      <div class="mp-chart-card">
        <div class="mp-chart-title">BMI trend</div>
        <div class="mp-chart-sub">${records.length > 1 ? 'Hover a point for the exact date and value.' : 'Save one more result to see a trend line.'}</div>
        ${renderChart(records)}
        <div class="mp-legend">
          ${BMI_BANDS.map(b => `<div class="mp-legend-item"><span class="mp-legend-dot" style="background:${b.color}"></span>${b.label}</div>`).join('')}
        </div>
      </div>

      <div class="mp-table-card" style="margin-bottom:20px;">
        <div class="mp-table-header">
          <div class="mp-table-title" style="padding:0;">BMI history</div>
          <button class="mp-delete-all" onclick="deleteAllHistory()">Delete all history</button>
        </div>
        <table class="mp-table">
          <thead><tr><th>Date</th><th>BMI</th><th>Category</th><th>Weight</th><th></th></tr></thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
      ${toolSectionsHtml}`;
  }

  function renderLoginForm() {
    const wrap = document.getElementById('mp-wrap');
    wrap.innerHTML = `
      <div class="mp-login-card">
        <div class="mp-login-icon">📈</div>
        <h1>Sign in to see your progress</h1>
        <p>Enter your email and we'll send you a login link — no password needed.</p>
        <input type="email" id="mp-email" class="mp-input" placeholder="you@example.com" aria-label="Email address">
        <label class="mp-checkbox">
          <input type="checkbox" id="mp-consent-save" checked>
          <span>Save my BMI history so I can track changes over time (required)</span>
        </label>
        <label class="mp-checkbox">
          <input type="checkbox" id="mp-consent-marketing">
          <span>Also send me occasional progress reminders and tips by email (optional)</span>
        </label>
        <button type="button" class="calc-btn" id="mp-submit" onclick="mpSubmitLogin()" style="width:100%;">Email me a login link →</button>
        <div class="mp-status" id="mp-status"></div>
      </div>
    `;
  }

  async function mpSubmitLogin() {
    const statusEl = document.getElementById('mp-status');
    const email = document.getElementById('mp-email').value.trim();
    const consentSave = document.getElementById('mp-consent-save').checked;
    const consentMarketing = document.getElementById('mp-consent-marketing').checked;
    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    if (!emailOk) {
      statusEl.textContent = 'Please enter a valid email address.';
      statusEl.className = 'mp-status error';
      return;
    }
    if (!consentSave) {
      statusEl.textContent = 'Please check the box to save your history — it\'s required.';
      statusEl.className = 'mp-status error';
      return;
    }

    const btn = document.getElementById('mp-submit');
    btn.disabled = true;
    statusEl.textContent = 'Sending...';
    statusEl.className = 'mp-status';

    try {
      const resp = await fetch('/api/auth/request-link', {
        method: 'POST',
        cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          purpose: 'login',
          consent_save_records: consentSave,
          consent_marketing_email: consentMarketing
        })
      });
      if (resp.status === 429) {
        statusEl.textContent = 'You just requested a link — please check your email, or wait a minute before trying again.';
        statusEl.className = 'mp-status error';
        btn.disabled = false;
        return;
      }
      if (!resp.ok) throw new Error('request_failed');
      statusEl.textContent = '✓ Check your email for the login link.';
      statusEl.className = 'mp-status success';
      btn.disabled = false;
    } catch (e) {
      statusEl.textContent = 'Something went wrong. Please try again in a moment.';
      statusEl.className = 'mp-status error';
      btn.disabled = false;
    }
  }

  async function deleteRecord(id) {
    if (!confirm('Delete this entry? This can\'t be undone.')) return;
    try {
      const resp = await fetch('/api/records/delete', {
        method: 'POST',
        cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      });
      if (!resp.ok) throw new Error('delete_failed');
      loadProgress();
    } catch (e) {
      alert('Could not delete this entry. Please try again.');
    }
  }

  async function deleteAllHistory() {
    if (!confirm('Delete your entire BMI history? This can\'t be undone.')) return;

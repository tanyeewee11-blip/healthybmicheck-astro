---
import Base from '../layouts/Base.astro';

const breadcrumbJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://healthybmicheck.com/" },
    { "@type": "ListItem", "position": 2, "name": "Medical Disclaimer", "item": "https://healthybmicheck.com/disclaimer" }
  ]
});
---

<Base
  title="Medical Disclaimer — HealthyBMICheck.com"
  description="Medical and health disclaimer for HealthyBMICheck.com. All calculators and health content are provided for informational and educational purposes only."
  canonical="https://healthybmicheck.com/disclaimer"
  breadcrumbJson={breadcrumbJson}
>
  <div style="max-width:760px;margin:0 auto;padding:36px 20px 60px;color:var(--ink);line-height:1.8;">
    <div style="font-size:.82rem;color:var(--ink3);margin-bottom:16px;">
      <a href="/" style="color:inherit;text-decoration:none;">Home</a> &rsaquo; Medical Disclaimer
    </div>

    <h1 style="font-family:'DM Serif Display',serif;font-size:2.2rem;margin-bottom:12px;">Medical Disclaimer</h1>
    <p style="font-size:.85rem;color:var(--ink3);margin-bottom:28px;">Last updated: October 2026</p>

    <div style="background:var(--accent-light);border-left:4px solid var(--accent);padding:16px 20px;border-radius:8px;margin-bottom:28px;">
      <strong style="color:var(--accent);display:block;margin-bottom:4px;">Important Notice</strong>
      HealthyBMICheck.com does not provide clinical medical advice. All content, interactive calculators, formulas, and charts are intended purely for educational and general screening purposes.
    </div>

    <h2 style="font-size:1.25rem;font-weight:600;margin:28px 0 10px;">Not a Substitute for Professional Medical Care</h2>
    <p>The assessments produced by our tools (including BMI, BMR, Body Fat Percentage, and Calorie targets) are population-level statistical estimates. They do not evaluate clinical factors such as blood biochemistry, cardiovascular risk, visceral fat distribution, or personal medical history.</p>
    <p>Never disregard professional medical advice or delay seeking medical evaluation because of information or calculation results obtained from this website.</p>

    <h2 style="font-size:1.25rem;font-weight:600;margin:28px 0 10px;">Accuracy of Evidence-Based Guidelines</h2>
    <p>While all formulas used across this platform are sourced directly from peer-reviewed scientific literature and established health organizations (such as the World Health Organization, CDC, and NIH), HealthyBMICheck.com cannot guarantee that calculations apply to every individual physiological condition.</p>

    <h2 style="font-size:1.25rem;font-weight:600;margin:28px 0 10px;">Emergency Care</h2>
    <p>If you believe you may be experiencing a medical emergency, immediately contact your local emergency services (such as 999 in Malaysia, 911 in the US, or your regional emergency helpline) or proceed to the nearest hospital facility.</p>
  </div>
</Base>